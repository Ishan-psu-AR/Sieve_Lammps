LAMMPS (23 Jun 2022 - Update 2)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task

# Pour granular particles into chute container, then induce flow


atom_style      sphere
boundary        p p f
newton          off
comm_modify     vel yes

lattice         sc 1
Lattice spacing in x,y,z = 1 1 1
region          reg block -5.5 5.5 -5.5 5.5 -0.5 49.5 units box
create_box      2 reg
Created orthogonal box = (-5.5 -5.5 -0.5) to (5.5 5.5 49.5)
  1 by 1 by 4 MPI processor grid

# upper box
region          upreg block -5 5 -5 5 40 49.5 units box
# lattice
region          ok block -5.5 5.5 -5.5 5.5  19.5 20.5 units box
region          cily cylinder z 0 0 1 18 21

neighbor        0.2 bin
neigh_modify    delay 0

# lattice creation
create_atoms    1 region ok
Created 121 atoms
  using lattice units in orthogonal box = (-5.5 -5.5 -0.5) to (5.5 5.5 49.5)
  create_atoms CPU = 0.160 seconds

set             type 1 mass 1.0
Setting atom values ...
  121 settings made for mass
set             type 1 diameter 1.0
Setting atom values ...
  121 settings made for diameter

# type groups
group           big type 1
121 atoms in group big
group           small type 2
0 atoms in group small
#group           three type 3

# IMPORTANT NOTE: these values of stiffness (2000) and timestep (0.001)
# are used in this example file to produce a quick simulation and movie.
# More appropriate values for realistic simulations would be
# k = 2.0e5 and dt = 0.0001, as in bench/in.chute.

pair_style      gran/hertz/history 200000.0 NULL 50 NULL 1  0

pair_coeff      1 *
pair_coeff      2 2*
#pair_coeff      3 3*


timestep        0.001
fix             1 all nve/sphere
fix             2 all gravity 1.0 spherical 0.0 -180.0

#plane
fix             zlower all wall/gran hertz/history 200000.0 NULL 50 NULL 1 0                 zplane 0 2000.0

# fix lattice
fix             e big  freeze

# thermo comands

compute         tmp small temp/region cily

#force on red due to blue

compute         force big group/group small



thermo          1000
thermo_style    custom step atoms c_tmp c_force
thermo_modify   lost ignore norm no
compute_modify  thermo_temp dynamic/dof yes

# dumping position and ke

dump            1 all atom 1000 single3.por
#dump            2 all custom 1000 ked.pour id  mass

#delete_atoms     region cily

fix              sml small pour 500 2 4872 region upreg diam one 0.4
Particle insertion: 7087 every 4359 steps, 500 by step 1
set              type 2 mass 0.064
Setting atom values ...
  0 settings made for mass

run              250000
